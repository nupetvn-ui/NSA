{
  "name": "@nsa/plugin-host",
  "version": "0.0.0",
  "private": true,
  "description": "Plugin host: cài, cấp quyền, chạy cô lập, cập nhật plugin của App Store",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "nsa-plugin": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "@nsa/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nsa/core": "workspace:*",
    "@nsa/mcp-gateway": "workspace:*",
    "@nsa/plugin-sdk": "workspace:*"
  }
}
