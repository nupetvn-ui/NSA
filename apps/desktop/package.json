{
  "name": "@nsa/desktop",
  "productName": "NSA",
  "version": "0.1.0",
  "private": true,
  "description": "NSA — điều phối nhiều agent AI chạy qua CLI",
  "author": "nupetvn-ui",
  "license": "UNLICENSED",
  "homepage": "https://github.com/nupetvn-ui/NSA",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "release:win": "electron-vite build && electron-builder --win --publish always",
    "icons": "node scripts/render-icons.mjs"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.18",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@nsa/adapter-antigravity": "workspace:*",
    "@nsa/adapter-claude": "workspace:*",
    "@nsa/adapter-codex": "workspace:*",
    "@nsa/adapter-gemini": "workspace:*",
    "@nsa/adapter-opencode": "workspace:*",
    "@nsa/adapter-pty": "workspace:*",
    "@nsa/adapter-sdk": "workspace:*",
    "@nsa/core": "workspace:*",
    "@nsa/memory": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8"
  },
  "optionalDependencies": {
    "@lydell/node-pty-win32-x64": "1.2.0-beta.18"
  }
