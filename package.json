{
  "name": "nsa",
  "private": true,
  "description": "NSA — điều phối nhiều agent AI chạy qua CLI",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.14.0 <25",
    "pnpm": ">=10.33.0 <11"
  },
  "scripts": {
    "dev": "pnpm --filter @nsa/desktop dev",
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm --filter @nsa/desktop build",
    "dist:win": "pnpm --filter @nsa/desktop dist:win",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:live": "vitest run packages/adapters/contract-live",
    "adapters:pack": "node apps/desktop/scripts/adapter-packs.mjs pack",
    "adapters:keygen": "node apps/desktop/scripts/adapter-packs.mjs keygen"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "playwright-core": "^1.65.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
